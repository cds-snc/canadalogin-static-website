<!DOCTYPE html>
<html lang="{{ locale }}" dir="ltr">

<head>
  <!-- Google tag (gtag.js) -->
  <!-- <script async src="https://www.googletagmanager.com/gtag/js?id=G-5TBZBZVVK8"></script> -->
  <!-- <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-5TBZBZVVK8');
  </script> -->

  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>{% block page_title %}{{ title }} - {{ base[locale].gcds }}{% endblock %}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow, noarchive">

  <!-- Utility framework -->
  <link rel="stylesheet"
    href="https://cdn.design-system.alpha.canada.ca/@cdssnc/gcds-utility@1.5.0/dist/gcds-utility.min.css" />

  <link rel="stylesheet" href="{{ '/styles/prism.css' | url }}">
  <link rel="stylesheet" href="{{ '/styles/style.css' | url }}">
  <script src="{{ '/scripts/code-showcase.js' | url }}"></script>
  <script src="{{ '/scripts/code-copy.js' | url }}"></script>
  <script src="{{ '/scripts/component-preview.js' | url }}"></script>
  <link rel="icon" type="image/x-icon" sizes="96x96" href="{{ '/favicon.ico' | url }}">

  <!-- Icons Font Awesome (to access icons, import Font Awesome) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"
    crossorigin="anonymous">

  <!-- GC Design System  Components-->
  <link rel="stylesheet"
    href="https://cdn.design-system.alpha.canada.ca/@cdssnc/gcds-components@0.30.0/dist/gcds/gcds.css">
  <script type="module" src="/components/dist/gcds/gcds.esm.js"></script>
  <script nomodule=""
    src="https://cdn.design-system.alpha.canada.ca/@cdssnc/gcds-components@0.30.0/dist/gcds/gcds.js"></script>

  <!-- Pagefind -->
  <script src="/pagefind/pagefind.js" type="module"></script>
  <script src="{{ '/scripts/search.js' | url }}" type="module"></script>

</head>

<body>


  <div class="content-wrapper">
  {% include "partials/header.njk" %}
    <main id="mc" class="container-xl mx-auto xl:px-0 sm:px-600 px-225 general-layout" {% if not nocrawl
      %}data-pagefind-body{% endif %}>
      {% block content %}{{ content | safe }}{% endblock %}


    </main>


  </div>
<div class="footer-wrapper">
        <gcds-footer display="compact" lang="{{ locale }}"
            sub-links='{ "{{ footer[locale].sub.about }}": "{{ footer[locale].sub.abouturl }}",
            "{{ footer[locale].sub.help }}": "{{ footer[locale].sub.helpurl }}",
            "{{ footer[locale].sub.terms }}": "{{ footer[locale].sub.termsurl }}" }'></gcds-footer>
    </div>
  {% initClipboardJS %}
</body>

</html>