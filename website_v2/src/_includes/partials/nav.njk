{% set navPages = collections.all | eleventyNavigation %}

{% macro renderNavListItem(entry) -%}
{% if not entry.hideMain %}
{% if entry.group %}
    <gcds-nav-group  open-trigger="{{ entry.title }}" menu-label="{{ entry.title }}">
        {% for child in entry.group %}
            {% if child.url=="" %}
                <gcds-nav-link href="{{nav[locale].url}}/" {% if nav[locale].url~"/"==page.url %}current{% endif %}>{{child.title}}</gcds-nav-link>
            {% else %}
                <gcds-nav-link href="{{nav[locale].url}}/{{child.url}}/" {% if nav[locale].url~"/"~child.url~"/"==page.url %}current{% endif %}>{{child.title}}</gcds-nav-link>
            {% endif %}
        {% endfor %}
    </gcds-nav-group>
{% else %}
{% if entry.url %}
<gcds-nav-link href="{{ entry.url | url }}" {% if entry.url==page.url %}current{% endif %}>
  {{ entry.title }}
</gcds-nav-link>
{% endif %}
{% endif %}
{% endif %}
{%- endmacro %}
<gcds-top-nav slot="menu" label="{{ nav[locale].label }}" alignment="right">
  <gcds-nav-link slot="home" href="{{ nav[locale].url | url }}" class="home-link link-inherit link-no-underline"
    slot="left">{{ nav[locale].title }}</gcds-nav-link>

  {%- for entry in navPages %}
  {%- if entry.locale == locale %}{{ renderNavListItem(entry) }}{% endif -%}
  {%- endfor -%}
</gcds-top-nav>