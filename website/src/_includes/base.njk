    <title>{{product_title}}</title>

    <!---------- GC Design System Utility ---------->
    <link rel="stylesheet"
        href="https://cdn.design-system.alpha.canada.ca/@cdssnc/gcds-utility@1.5.0/dist/gcds-utility.min.css">

    <!---------- GC Design System Components ---------->
    <link rel="stylesheet"
        href="https://cdn.design-system.alpha.canada.ca/@cdssnc/gcds-components@0.30.0/dist/gcds/gcds.css">
    <script type="module"
        src="https://cdn.design-system.alpha.canada.ca/@cdssnc/gcds-components@0.30.0/dist/gcds/gcds.esm.js"></script>
    <script nomodule=""
        src="https://cdn.design-system.alpha.canada.ca/@cdssnc/gcds-components@0.30.0/dist/gcds/gcds.js"></script>
</head>

<body>
    <!---------- Header ---------->
    <!-- TODO: Modify the lang-href to set the language toggle's URL. -->
    <!-- TODO: Update the skip-to-href with the main content container's id. -->

    <gcds-header lang-href="#" skip-to-href="#main-content">
        <!-- The slot="breadcrumb" attribute adds the breadcrumbs component to the header. -->
        {% include 'nav.njk' %}
        <gcds-breadcrumbs slot="breadcrumb"></gcds-breadcrumbs>

    </gcds-header>

    <!---------- Main content ---------->
    <!-- TODO: Confirm the id matches the "skip-to-href" id in the header. -->
    <gcds-container id="main-content" main-container size="xl" centered tag="main">
        <!-- TODO: Update the heading and text content. -->
        <section>
            <gcds-heading tag="h1">{{title}}</gcds-heading>
        </section>
        <section>
            {{content | safe}}
        </section>

        <gcds-date-modified>Test</gcds-date-modified>
    </gcds-container>

    <gcds-footer display="full" contextual-heading="Canadian Digital Service">
    </gcds-footer>

</body>

</html>