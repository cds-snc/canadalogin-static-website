<gcds-footer 
    display="full" 
    contextual-heading="GC Sign in" 
    contextual-links='{ 
    {% if page.url == "/en/" %}
        "GC Sign in Users": "{{ links.users }}",
        "GC Sign in Partners": "{{ links.partners }}"
    {% elif page.url | startsWith("/en/users/") %}
        "GC Sign in Users": "{{ links.users }}",
        "About GC Sign in": "{{ links.aboutgcsignin }}", 
        "Contact us": "{{ links.contact }}"     
    {% else %}
        "GC Sign in Partners": "{{ links.partners }}",
        "About GC Sign in": "{{ links.aboutgcsignin }}", 
        "Contact us": "{{ links.contact }}"
    {% endif %} 
    }'
sub-links='{ 
    "About Canada.ca": "{{ links.aboutcanadaca }}", 
    "Terms and conditions": "{{ links.termsandconditionspartners }}", 
    "Privacy": "{{ links.termsandprivacyusers }}" 
}'>
</gcds-footer>